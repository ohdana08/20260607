# ─────────────────────────────────────────────────────────────────────────
# gov-plan — environment variables
# Copy to `.env.local` for local dev.
# 두 그룹으로 나뉩니다:
#   (A) SERVER-ONLY SECRETS — 절대 NEXT_PUBLIC_ 접두사 금지. 브라우저에 닿으면 안 됨.
#   (B) PUBLIC IDs — 노출돼도 되는 값(측정 ID 등)만 NEXT_PUBLIC_ 로 둠.
# In production set them as Vercel project env vars (+ GitHub Actions secrets
# for the collector).
# ─────────────────────────────────────────────────────────────────────────

# ===== (A) SERVER-ONLY SECRETS — 브라우저 노출 금지 ======================

# --- Database (Supabase Postgres) ---
# Pooled connection (pgBouncer, port 6543) — used by the Vercel app.
DATABASE_URL=
# Direct connection (port 5432) — used for migrations and the GitHub Actions collector.
DIRECT_URL=
# ⚠️ 2026-07-14 스프린트 구현: scripts/collect-programs.mts(GitHub Actions 배치)와
#    lib/data/programs.ts(앱 읽기)는 위 DATABASE_URL/DIRECT_URL이 아니라 아래
#    NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY(@supabase/supabase-js)를 쓴다 —
#    leads/evidence_map과 같은 기존 패턴 재사용. DATABASE_URL/DIRECT_URL은 현재 미사용.

# --- LLM providers (user picks Claude or OpenAI at runtime) ---
# ⚠️ ANTHROPIC_API_KEY 는 오직 서버(API 라우트)에서만 사용됨. 프론트엔드/브라우저 어디에도
#    노출되지 않음 (Next.js 서버가 프록시 역할 — 별도 Cloudflare Worker 불필요).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Public data sources (free keys from the respective portals) ---
# data.go.kr service key for the K-Startup announcement dataset (15125364).
KSTARTUP_KEY=
# data.go.kr service key for 기획예산처_국고보조금 공모사업 상세 (#15156853).
# 개발·운영 자동승인이지만 활용신청은 필수. 같은 data.go.kr 프로젝트 키라면
# KSTARTUP_KEY로 폴백되지만 운영에서는 용도를 분명히 하기 위해 별도 이름을 권장.
BOJO_SERVICE_KEY=
# bizinfo.go.kr certification key (crtfcKey).
BIZINFO_KEY=
# kocca.kr 자체 발급 Open API 서비스키 (data.go.kr 경유 아님 — kocca.kr Open API 메뉴에서 신청).
# 없으면 lib/data/kocca.ts가 조용히 [] 반환(다른 소스와 동일 관례) — 배치 로그에 0건 경고로 남는다.
KOCCA_KEY=
# NIPA(nipa.kr)·SMTECH(smtech.go.kr)는 국내 사업공고를 다루는 공식 API가 없어(2026-07 확인)
# lib/data/nipa.ts·smtech.ts가 공개 게시판을 직접 파싱한다 — 키 불필요.

# --- Rate limiting / cost control (Upstash Redis, free tier) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron protection ---
# Shared secret the Vercel daily cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- 이용권(가벼운 검증형 결제) 코드 ---
# 유효한 이용권 코드들(콤마 구분). 입금 확인 후 고객에게 발급. (// TODO: PG 연동 전 임시)
ACCESS_CODES=
# 운영자 전용 마스터 코드(콤마 구분) — 사업에 묶이지 않고 무제한.
MASTER_CODES=

# --- Groble 단일 웹훅 → BCC Claude101 수강권 전달 ---
# 그로블의 Claude101 결제창 content ID. 이 상품 이벤트만 BCC로 전달한다.
BCC_CLAUDE101_GROBLE_CONTENT_ID=
# BCC 홈페이지 Vercel의 서버 전용 수신 API.
BCC_GROBLE_FORWARD_URL=https://bcc-homepage.vercel.app/api/groble-claude101-event
# BCC 홈페이지 프로젝트의 BCC_GROBLE_FORWARD_SECRET과 같은 긴 랜덤 값.
BCC_GROBLE_FORWARD_SECRET=

# --- 후기 저장 (구글시트 GAS 웹훅) — gas/review-collector.gs ---
# 설정하면 후기를 구글시트에 저장/조회. 비워두면 Upstash Redis로 자동 폴백.
GAS_WEBHOOK_URL=

# --- 이메일 게이트 리드 저장: Supabase leads (BCC CRM과 동일 프로젝트/테이블) ---
# /api/lead/email 이 leads 테이블에 insert (홈페이지 폼 /api/lead 와 동일 테이블).
# Supabase 실패 시에만 아래 GAS로 폴백한다.
# URL·anon은 공개 OK지만, 이 앱은 서버 insert만 하므로 service_role 만 있으면 된다.
NEXT_PUBLIC_SUPABASE_URL=
# ⚠️ 서버 전용 마스터 키. NEXT_PUBLIC_ 금지. 깃/로그/브라우저 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# --- 진단 보고서 Gmail 발송 + (Supabase 실패 시) 리드 폴백 저장 — gas/diagnosis-mailer.gs ---
# 전체 진단 보고서 메일 발송에 사용. 비워두면 보고서 메일 발송 불가(GAS 필요).
GAS_DIAGNOSIS_URL=

# (선택) 두 GAS의 Script Property REVIEW_TOKEN 과 매칭되는 토큰 — 외부 스팸 차단.
GAS_TOKEN=

# ===== (B) PUBLIC IDs — 노출 OK (측정용) =================================
# GA4 측정 ID는 비밀이 아니므로 NEXT_PUBLIC_ 로 둬서 클라이언트(브라우저)에서 GA4에 전달.
# 루트 layout의 <GoogleAnalytics> 가 이 값을 읽어 랜딩(/)·/embed 모두에 GA4를 로드.
NEXT_PUBLIC_GA_ID=G-TYJSYWW5Q6

# (대안) GTM 방식으로 전환할 경우에만 사용. 현재는 GA4 측정 ID 직접 설치 방식이라
# 동시에 켜면 페이지뷰가 이중 집계될 수 있으니 둘 중 하나만 사용한다.
# NEXT_PUBLIC_GTM_ID=GTM-K94NGCTP

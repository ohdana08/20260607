# ─────────────────────────────────────────────────────────────────────────
# gov-plan — environment variables
# Copy to `.env.local` for local dev.
# 두 그룹으로 나뉩니다:
#   (A) SERVER-ONLY SECRETS — 절대 NEXT_PUBLIC_ 접두사 금지. 브라우저에 닿으면 안 됨.
#   (B) PUBLIC IDs — 노출돼도 되는 값(측정 ID 등)만 NEXT_PUBLIC_ 로 둠.
# In production set them as Vercel project env vars (+ GitHub Actions secrets
# for the collector).
# ─────────────────────────────────────────────────────────────────────────

# ===== (A) SERVER-ONLY SECRETS — 브라우저 노출 금지 ======================

# --- Database (Supabase Postgres) ---
# Pooled connection (pgBouncer, port 6543) — used by the Vercel app.
DATABASE_URL=
# Direct connection (port 5432) — used for migrations and the GitHub Actions collector.
DIRECT_URL=

# --- LLM providers (user picks Claude or OpenAI at runtime) ---
# ⚠️ ANTHROPIC_API_KEY 는 오직 서버(API 라우트)에서만 사용됨. 프론트엔드/브라우저 어디에도
#    노출되지 않음 (Next.js 서버가 프록시 역할 — 별도 Cloudflare Worker 불필요).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Public data sources (free keys from the respective portals) ---
# data.go.kr service key for the K-Startup announcement dataset (15125364).
KSTARTUP_KEY=
# bizinfo.go.kr certification key (crtfcKey).
BIZINFO_KEY=

# --- Rate limiting / cost control (Upstash Redis, free tier) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron protection ---
# Shared secret the Vercel daily cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- 이용권(가벼운 검증형 결제) 코드 ---
# 유효한 이용권 코드들(콤마 구분). 입금 확인 후 고객에게 발급. (// TODO: PG 연동 전 임시)
ACCESS_CODES=
# 운영자 전용 마스터 코드(콤마 구분) — 사업에 묶이지 않고 무제한.
MASTER_CODES=

# --- 후기 저장 (구글시트 GAS 웹훅) ---
# 설정하면 후기를 구글시트에 저장/조회. 비워두면 Upstash Redis로 자동 폴백.
GAS_WEBHOOK_URL=
# (선택) GAS Script Property REVIEW_TOKEN 과 매칭되는 토큰 — 외부 스팸 차단.
GAS_TOKEN=

# ===== (B) PUBLIC IDs — 노출 OK (측정용) =================================
# 측정 ID는 비밀이 아니므로 NEXT_PUBLIC_ 로 둬서 클라이언트에서 GA4/GTM에 전달.
NEXT_PUBLIC_GA4_ID=G-TYJSYWW5Q6
NEXT_PUBLIC_GTM_ID=GTM-K94NGCTP

{
  "name": "gov-plan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:operations": "node scripts/dev-operations.mjs",
    "test:operations": "node --experimental-transform-types --test tests/operations.test.ts tests/operations-alert.test.ts tests/operations-resilience.test.mjs",
    "report:plan-cost": "node --env-file=.env.local scripts/report-plan-ai-cost.mjs",
    "test:backup": "node --test tests/operations-backup.test.mjs",
    "test:guards": "node --no-warnings --experimental-strip-types scripts/verify-product-guards.mjs",
    "test:refactor": "node --experimental-strip-types --test tests/refactor-contracts.test.mjs tests/form-headings.test.mjs",
    "test:collection": "node --test tests/collection-rca.test.mjs",
    "test:scale": "node --test tests/scale-unit.test.mjs",
    "test:scale:integration": "node --test tests/scale-integration.test.mjs",
    "benchmark:scale": "node scripts/scale-benchmark.mjs",
    "test:performance": "node --test tests/performance.test.mjs",
    "test:team": "node --test tests/performance.test.mjs tests/team-review.test.mjs tests/team-sre.test.mjs",
    "test:release": "node --experimental-transform-types --test tests/operations-backup.test.mjs tests/operations.test.ts tests/operations-alert.test.ts tests/operations-resilience.test.mjs tests/refactor-contracts.test.mjs tests/form-headings.test.mjs tests/collection-rca.test.mjs tests/scale-unit.test.mjs tests/performance.test.mjs tests/team-review.test.mjs tests/team-sre.test.mjs tests/release-operations.test.ts tests/release-operations-hook.test.mjs tests/release-plan.test.mjs tests/release-sre.test.mjs",
    "test:release:integration": "node --test tests/scale-integration.test.mjs tests/release-payment-state.test.mjs tests/release-reviewer.test.mjs",
    "benchmark:team": "node --expose-gc scripts/performance-team-benchmark.mjs",
    "benchmark:performance:before": "node --expose-gc scripts/performance-benchmark.mjs --before",
    "benchmark:performance": "node --expose-gc scripts/performance-benchmark.mjs",
    "benchmark:performance:db": "node scripts/performance-db-benchmark.mjs",
    "check:architecture": "node scripts/analyze-architecture.mjs --check",
    "report:architecture": "node scripts/analyze-architecture.mjs --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@next/third-parties": "16.3.4",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.108.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/queue": "0.5.1",
    "cfb": "^1.2.0",
    "docx": "^9.7.1",
    "driver.js": "^1.4.0",
    "hwp.js": "^0.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "16.3.4",
    "openai": "^6.42.0",
    "pako": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
